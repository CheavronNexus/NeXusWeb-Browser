{
  "name": "nexusweb-v3",
  "version": "3.0.0",
  "description": "NeXusWeb V3 - Privacy & Developer Browser",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:vite": "vite build",
    "package": "vite build && electron-packager . \"NeXusWeb-V3\" --platform=win32 --arch=x64 --electron-version=28.3.3 --out=\"dist-electron\" --overwrite --asar --ignore=\"dist-electron|\\.git|\\.vite\"",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "keywords": [
    "electron",
    "browser",
    "localhost",
    "developer",
    "v2"
  ],
  "author": "NeXusWeb",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-packager": "^17.1.2",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.3.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  }
}
